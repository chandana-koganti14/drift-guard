{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear|startup",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/run.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
